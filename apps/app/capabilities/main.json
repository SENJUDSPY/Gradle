{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Main window capability for Gradle",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-internal-toggle-maximize",
		"core:window:allow-create",
		"core:window:allow-maximize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-unmaximize",
		"core:window:allow-minimize",
		"core:window:allow-unminimize",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-close",
		"core:window:allow-set-decorations",
		"core:window:allow-start-dragging",
		"core:webview:allow-set-webview-zoom",
		"core:menu:default",
		"core:image:default",
		"core:resources:default",
		"os:default",
		"fs:allow-exists",
		"fs:allow-read-file",
		"fs:allow-read-dir",
		"fs:allow-read-text-file",
		"fs:allow-stat",
		{
			"identifier": "fs:scope",
			"allow": [
				{
					"path": "$APPDATA/profiles"
				},
				{
					"path": "$APPDATA/profiles/**"
				},
				{
					"path": "$APPCONFIG/profiles"
				},
				{
					"path": "$APPCONFIG/profiles/**"
				},
				{
					"path": "$CONFIG/profiles"
				},
				{
					"path": "$CONFIG/profiles/**"
				}
			]
		},
		"opener:default",
		"opener:allow-reveal-item-in-dir",
		"dialog:allow-open",
		"dialog:allow-confirm",
		"dialog:allow-message",
		"dialog:allow-save",
		"deep-link:default",
		"window-state:default",
		"window-state:allow-save-window-state",
		"window-state:allow-restore-state",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://xorison.dev/*"
				},
				{
					"url": "https://*.xorison.dev/*"
				},
				{
					"url": "https://authserver.ely.by/*"
				},
				{
					"url": "https://account.ely.by/*"
				},
				{
					"url": "https://ely.by/*"
				},
				{
					"url": "https://modrinth.com/*"
				},
				{
					"url": "https://*.modrinth.com/*"
				},
				{
					"url": "https://*.nodes.modrinth.com/*"
				},
				{
					"url": "https://api.mclo.gs/*"
				},
				{
					"url": "https://fill.papermc.io/*"
				},
				{
					"url": "https://api.purpurmc.org/*"
				},
				{
					"url": "http://localhost:8000/*"
				},
				{
					"url": "http://127.0.0.1:8000/*"
				},
				{
					"url": "http://*.taila228c5.ts.net/*"
				},
				{
					"url": "https://*.taila228c5.ts.net/*"
				}
			]
		},
		"default",
		"allow-instance-content",
		"allow-files-save-external",
		"auth:default",
		"cache:default",
		"files:default",
		"files:allow-files-save-external",
		"friends:default",
		"horizon:default",
		"import:default",
		"install:default",
		"instance:default",
		"instance:allow-instance-content",
		"jre:default",
		"logs:default",
		"metadata:default",
		"minecraft-skins:default",
		"mr-auth:default",
		"onboarding-checklist:default",
		"p2p:default",
		"process:default",
		"reports:default",
		"settings:default",
		"shortcuts:default",
		"tags:default",
		"users:default",
		"utils:default",
		"worlds:default"
	]
}
