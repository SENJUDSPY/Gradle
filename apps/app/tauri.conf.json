{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeDevCommand": "mise exec -- pnpm -w i18n:coverage && pnpm turbo run dev --filter=@modrinth/app-frontend",
		"beforeBuildCommand": "mise exec -- pnpm turbo run build --filter=@modrinth/app-frontend",
		"frontendDist": "../app-frontend/dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"category": "Game",
		"copyright": "Copyright 2026 Xorison",
		"publisher": "Gradle Team <support@gradle.app>",
		"targets": "all",
		"externalBin": [],
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/256x256.png",
			"icons/512x512.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerHooks": "./nsis/hooks.nsi"
			}
		},
		"longDescription": "Gradle is a modern, high-performance Minecraft launcher supporting both optimized native Rust and classic Java runtimes.",
		"macOS": {
			"entitlements": "App.entitlements",
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null,
			"dmg": {
				"background": "./dmg/dmg-background.png",
				"windowSize": {
					"width": 661,
					"height": 432
				},
				"appPosition": {
					"x": 188,
					"y": 212
				},
				"applicationFolderPosition": {
					"x": 475,
					"y": 212
				}
			}
		},
		"shortDescription": "Modern Minecraft launcher with native Rust and classic Java runtimes",
		"homepage": "https://xorison.dev",
		"linux": {
			"deb": {
				"section": "games",
				"depends": [
					"libayatana-appindicator3-1",
					"libc6 (>= 2.39)"
				],
				"desktopTemplate": "./desktop-template.desktop"
			}
		},
		"fileAssociations": []
	},
	"productName": "gradle-launcher",
	"version": "../app-frontend/package.json",
	"mainBinaryName": "Gradle",
	"identifier": "GradleApp",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["gradle"]
			},
			"mobile": []
		}
	},
	"app": {
		"withGlobalTauri": false,
		"macOSPrivateApi": true,
		"windows": [
			{
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"fullscreen": false,
				"height": 800,
				"resizable": true,
				"title": "Gradle",
				"label": "main",
				"width": 1280,
				"minHeight": 700,
				"minWidth": 1100,
				"visible": false,
				"zoomHotkeysEnabled": false,
				"decorations": false
			}
		],
		"security": {
			"assetProtocol": {
				"scope": [
					"$APPDATA/caches/icons/*",
					"$APPCONFIG/caches/icons/*",
					"$CONFIG/caches/icons/*",
					"$APPDATA/profiles/*/saves/*/icon.png",
					"$APPCONFIG/profiles/*/saves/*/icon.png",
					"$CONFIG/profiles/*/saves/*/icon.png"
				],
				"enable": true
			},
			"capabilities": ["main", "debug-devtools"],
			"csp": {
				"default-src": "'self' customprotocol: asset:",
				"connect-src": "ipc: https://xorison.dev https://*.xorison.dev https://authserver.ely.by https://account.ely.by https://ely.by http://ipc.localhost https://modrinth.com https://*.modrinth.com https://*.nodes.modrinth.com https://api.mclo.gs http://textures.minecraft.net https://textures.minecraft.net wss://*.nodes.modrinth.com https://fill.papermc.io https://api.purpurmc.org 'self' data: blob:",
				"font-src": ["https://cdn.modrinth.com/fonts/"],
				"img-src": "https: 'unsafe-inline' 'self' asset: http://asset.localhost http://textures.minecraft.net blob: data:",
				"style-src": "'unsafe-inline' 'self'",
				"script-src": "'self'",
				"frame-src": "https://discord.com 'self'",
				"media-src": "https://*.githubusercontent.com"
			}
		}
	}
}
